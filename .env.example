NEXT_PUBLIC_BACKEND_URL=http://localhost:3333

# Twilio WhatsApp sandbox join link — Console → Messaging → Try it out → Send a WhatsApp message
NEXT_PUBLIC_WHATSAPP_BOT_URL=https://wa.me/14155238886?text=join%20observe-collect

# Privy
NEXT_PUBLIC_PRIVY_APP_ID=

# Tempo — "moderato" (testnet, default) or "mainnet". Mainnet must be explicit.
NEXT_PUBLIC_TEMPO_NETWORK=moderato
# Optional RPC override (blank = the chain's default public RPC)
NEXT_PUBLIC_TEMPO_RPC_URL=
# Fee payer that sponsors payers' network fees. The public sponsor is testnet-only and is the default on moderato;
# on mainnet, set your own (blank on mainnet = payers pay the sub-cent fee in the token themselves).
# To use MistPay's own fee payer (backend FEE_PAYER_KEY), point at it: e.g. http://localhost:3333/api/sponsor
NEXT_PUBLIC_SPONSOR_URL=
